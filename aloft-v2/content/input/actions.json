{
  "$notes": {
    "about": "Default bindings shared by the web game and the Godot scaffold. keys = KeyboardEvent.code; gamepadButtons = standard-gamepad indices (0 A, 1 B, 2 X, 3 Y, 4 LB, 5 RB, 6 LT, 7 RT, 8 Back, 9 Start, 12 D-pad up); mouse = left / right.",
    "axes": "the four directions of the virtual steering stick",
    "holds": "held buttons read every step",
    "presses": "one-shot actions"
  },
  "axes": {
    "steer-left": { "keys": ["KeyA", "ArrowLeft"] },
    "steer-right": { "keys": ["KeyD", "ArrowRight"] },
    "steer-up": { "keys": ["KeyW", "ArrowUp"] },
    "steer-down": { "keys": ["KeyS", "ArrowDown"] }
  },
  "holds": {
    "boost": { "keys": ["Space"], "mouse": ["left"], "gamepadButtons": [0, 5, 7] },
    "brake": { "keys": ["ShiftLeft", "ShiftRight"], "mouse": ["right"], "gamepadButtons": [1, 4, 6] }
  },
  "presses": {
    "pause": { "keys": ["Escape", "KeyP"], "gamepadButtons": [9] },
    "toggle-view": { "keys": ["KeyV", "KeyC"], "gamepadButtons": [3] },
    "toggle-sound": { "keys": ["KeyM"] },
    "restart": { "keys": ["KeyR"], "gamepadButtons": [8] },
    "toggle-keys": { "keys": ["KeyH"] },
    "toggle-dev": { "keys": ["F3", "Backquote"] },
    "confirm": { "keys": ["Enter", "Space"], "gamepadButtons": [0] }
  }
}
