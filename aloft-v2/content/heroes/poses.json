{
  "$notes": {
    "about": "The hero pose library, shared by every hero and by the Godot port (web/src/core/hero-pose-graph.ts, godot/core/hero_pose_graph.gd). Rotations are Euler XYZ radians, local to each joint's parent, in the rig's bind pose: standing, facing +Z, +X on the hero's left, limbs hanging along -Y. The body joint is the navel pivot: x = pi/2 lays the figure flat to fly (head forward, chest down).",
    "conventions": "Elbows flex with negative x, knees with positive x, hips swing the thigh forward with negative x. Left clavicle lifts with +z, right with -z; left fingers curl with -z. Hand shapes are authored for the left hand; the right hand mirrors them (x, -y, -z).",
    "hands": "Finger-group and thumb rotations for each hand shape",
    "poses": "full: true = joints left out sit at rest; full: false (upper-body poses) = joints left out follow the flight poses. offset = shift of the body pivot in metres for the 1.86 m reference hero. handL / handR pick a hand shape (full poses default to open)",
    "graph": "How the graph blends and animates",
    "graph.springs": "dampingRatio 0.8 overshoots about 1.5%; the rest are angular frequencies (rad/s) per joint group: core (body, pelvis, spine), limb (arms, legs), hand (fingers, thumbs), head (neck, head), the body offset and the look angles",
    "graph.dive": "the dive pose fades in as the nose-down pitch goes from start to full radians",
    "graph.events": "burst (bursting through a building) and glance (bouncing off one) pulses: duration in seconds; rise and hold as shares of it",
    "graph.layers": "additive motion: bankLean (spine roll per radian of bank), bankHips (legs swing into the turn), steerDrift (lead arm follows the stick), breathRate rad/s and breathDepth rad (hover), idleSway rad (hover), flutterRate rad/s and flutterDepth rad (legs at boost), bobRate rad/s and bobHeight m (hover)",
    "graph.look": "head look-at: maxYaw / maxPitch clamp (rad), neckShare = part of the turn the neck takes (the head takes the rest), turnLead = seconds of yaw rate the head looks ahead into a turn",
    "graph.actions": "which pose each power phase shows and at what weight (null = none); M7's power state machines set the phases"
  },
